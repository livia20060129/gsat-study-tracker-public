{
  "name": "gsat-study-tracker-public",
  "private": true,
  "version": "171.6.0-public.56",
  "type": "module",
  "scripts": {
    "validate:env": "node scripts/validate-public-env.mjs",
    "predev": "npm run validate:env",
    "dev": "vite --configLoader runner",
    "prebuild": "npm run validate:env",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "prepreview": "npm run validate:env",
    "preview": "vite preview --configLoader runner",
    "preview:e2e": "vite preview --configLoader runner --host=127.0.0.1 --port=4174 --strictPort",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "deno check --config supabase/functions/google-calendar/deno.json --frozen supabase/functions/google-calendar/index.ts && deno check --config supabase/functions/google-calendar-callback/deno.json --frozen supabase/functions/google-calendar-callback/index.ts && deno check --config supabase/functions/cloud-translate/deno.json --frozen supabase/functions/cloud-translate/index.ts",
    "pretest": "npm run validate:env && node --experimental-strip-types --test tests/publicProjectBinding.test.ts",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "benchmark:runtime": "node --experimental-strip-types scripts/benchmark_runtime.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "4.132.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "2.114.0",
    "docx": "9.6.1",
    "pdf-lib": "1.17.1"
  }
}
