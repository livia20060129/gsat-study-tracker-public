# SAFE TEMPLATE ONLY. Never replace this tracked example with a real value.
# Copy this file to .env.local, then set the public Google OAuth Web client ID there.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# The build accepts no other VITE_ keys. Never place a client secret, token,
# password, private key, Supabase server key, or Calendar server setting here.
# Vite intentionally publishes every VITE_ value in the generated browser bundle.
