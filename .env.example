# Public Google OAuth 2.0 Web client ID used by the browser.
# Copy this file to .env.local for local development and replace the example.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Never add GOOGLE_CLIENT_SECRET or any refresh/access token to a VITE_ variable.
# Vite intentionally exposes every VITE_ value in the generated browser bundle.
